{
  "hooks": {
    "BeforeTool": [
      {
        "matcher": "^run_shell_command$",
        "hooks": [
          {
            "name": "anti-ai-design-session",
            "type": "command",
            "command": "[ ! -f $GEMINI_PROJECT_DIR/.gemini/skills/anti-ai-design/scripts/anti-ai-design ] || $GEMINI_PROJECT_DIR/.gemini/skills/anti-ai-design/scripts/anti-ai-design hook",
            "timeout": 5000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "anti-ai-design-completion",
            "type": "command",
            "command": "[ ! -f $GEMINI_PROJECT_DIR/.gemini/skills/anti-ai-design/scripts/anti-ai-design ] || $GEMINI_PROJECT_DIR/.gemini/skills/anti-ai-design/scripts/anti-ai-design hook",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
