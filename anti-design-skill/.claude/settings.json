{
  "description": "Anti-Design design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/anti-design/scripts/anti-design\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/anti-design/scripts/anti-design\" hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/anti-design/scripts/anti-design\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/anti-design/scripts/anti-design\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/anti-design/scripts/anti-design\" ] || \"${CLAUDE_PROJECT_DIR}/.claude/skills/anti-design/scripts/anti-design\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
