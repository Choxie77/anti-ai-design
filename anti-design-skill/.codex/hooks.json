{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".codex/skills/anti-ai-design/scripts/anti-ai-design\" ] || \".codex/skills/anti-ai-design/scripts/anti-ai-design\" hook",
            "commandWindows": "cmd /c if exist \".codex\\skills\\anti-ai-design\\scripts\\anti-ai-design.cmd\" \".codex\\skills\\anti-ai-design\\scripts\\anti-ai-design.cmd\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \".codex/skills/anti-ai-design/scripts/anti-ai-design\" ] || \".codex/skills/anti-ai-design/scripts/anti-ai-design\" hook",
            "commandWindows": "cmd /c if exist \".codex\\skills\\anti-ai-design\\scripts\\anti-ai-design.cmd\" \".codex\\skills\\anti-ai-design\\scripts\\anti-ai-design.cmd\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
